{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // Node runs these files directly, stripping types as it loads them. Nothing is ever emitted,
    // so TypeScript is a checker here and never a compiler (turbo-collection-spec.md 12.1).
    "noEmit": true,
    "allowImportingTsExtensions": true,

    // Type stripping erases; it does not transform. erasableSyntaxOnly rejects the syntax that
    // would need a real compiler: enum, namespace, parameter properties, import =. Without it,
    // code type checks and then fails to run.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
