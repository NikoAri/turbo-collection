# Starter .tcignore for a new Turbo-Collection copy.
#
# Turbo-Collection writes this file into a copy it creates that has none
# (turbo-collection-spec.md R-CLI-11). The patterns match files the operating
# system and its file managers create on their own: metadata, caches, and trash.
# After creation the file is yours; edit it freely.
#
# Source: github/gitignore Global templates for macOS, Windows, and Linux
# (https://github.com/github/gitignore/tree/main/Global). Patterns that match
# application- or user-created files (installers, shortcuts, shell and crash
# output, editor backups) are left out on purpose, so adopting an existing
# directory never silently skips a file someone meant to keep.

# macOS
.DS_Store
.localized
__MACOSX/
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.com.apple.timemachine.supported
.PKInstallSandboxManager
.PKInstallSandboxManager-SystemSoftware
.hotfiles.btree
.vol
.file
.disk_label*
lost+found
.apdisk
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
Desktop DB
Desktop DF
TheFindByContentFolder
TheVolumeSettingsFolder
.FBCIndex
.FBCSemaphoreFile
.FBCLockFolder
.quota.group
.quota.user
.quota.ops.group
.quota.ops.user
Backups.backupdb
.MobileBackups
.MobileBackups.trash
MobileBackups.trash
tmbootpicker.efi

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*
